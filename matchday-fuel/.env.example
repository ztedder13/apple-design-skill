# Copy to .env for local development (npm run dev), and add the same values in Netlify under
# Site configuration > Environment variables. Never commit .env.

# Square (developer.squareup.com > your application > Credentials)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# The public address of the site, used for the return link after payment
SITE_URL=http://localhost:8888

# Schedule: the secret iCal address of a calendar that holds only public stand stops
CALENDAR_ICS_URL=
CALENDAR_KEYWORD=
BUSINESS_TIMEZONE=America/New_York

# Stop taking orders this many minutes before a stop ends
ORDER_CUTOFF_MINUTES=15
